# Google AI Studio Configuration (Gemini)
# Get a free key at https://aistudio.google.com/apikey — no credit card required.
# One model (gemini-3.5-flash-lite) covers agent orchestration (tool-calling),
# NLP classification, and photo verification (vision) — all via Google's
# OpenAI-compatible endpoint. Free-tier request quotas are per-model and
# per-day — if you hit a 429 with "GenerateRequestsPerDayPerProjectPerModel",
# switch GOOGLE_MODEL to a different Gemini model (check available models/
# quotas at https://ai.dev/rate-limit) rather than waiting for the daily reset.
# The heavier "flash" (non-lite) models have much smaller free daily quotas
# and add an internal "thinking" token overhead that flash-lite doesn't.
GOOGLE_API_KEY=your-google-ai-studio-api-key-here
GOOGLE_MODEL=gemini-3.5-flash-lite

# Database (Supabase PostgreSQL connection string)
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Configuration
# Must be the service_role/secret key (Project Settings > API), not the anon/publishable
# key — Storage bucket creation and photo uploads require RLS-bypassing permissions.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Notification Service (Optional - viaSocket webhook URL)
NOTIFICATION_SERVICE_URL=https://api.viasocket.com/webhook/your-webhook-id

# CORS Origins (comma-separated list of allowed frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://returnpilot.vercel.app

# Environment
ENVIRONMENT=development
